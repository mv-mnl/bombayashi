/* Layout de panel dividido para el menu principal: categorias a la izquierda, opciones a la derecha */

mainbox {
    children: [ inputbar, columns ];
}

columns {
    orientation: horizontal;
    spacing: 12px;
    children: [ sidebar, listview ];
}

sidebar {
    orientation: vertical;
    width: 170px;
    background-color: @bg-alt;
    border-radius: 18px;
    padding: 6px;
    spacing: 2px;
}

button {
    text-color: @fg;
    padding: 10px 14px;
    horizontal-align: 0;
    border-radius: 14px;
}

button selected {
    background-color: @accent-soft;
    text-color: @accent;
}

listview {
    columns: 1;
    lines: 12;
}

window {
    width: 800px;
}
